PORT=3000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=wearable_health_db
DB_PASSWORD=changeme
DB_PORT=5432

# Signs/verifies login JWTs (see utils/jwt.js) — any long random string in
# dev; use a real secrets manager in production. Required, not optional:
# the server throws on startup if this is unset.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed origins for CORS. Unset -> wide open,
# which is fine for local dev against the emulator/simulator but should be
# set explicitly anywhere else.
CORS_ORIGIN=
